# TennisIQ settings (read by tennis/config.py via pydantic-settings from the
# environment or a .env file in the working directory). All are optional for local use.

# development | staging | production
ENVIRONMENT=development
DEBUG=true

# Auth: CHANGE THIS outside local development. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRY_HOURS=24
GOOGLE_CLIENT_ID=

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Storage paths
UPLOAD_DIR=./uploads
VIDEO_UPLOAD_DIR=./uploads/tennisiq
VIDEO_OUTPUT_DIR=./output/tennisiq
SESSION_DB_PATH=./data/tennisiq.db
MAX_VIDEO_SIZE_MB=2048

# Declared for future use; the current code does not call an LLM, Postgres or Redis.
OPENAI_API_KEY=
DATABASE_URL=sqlite:///./tennisiq.db
REDIS_URL=redis://localhost:6379/0

# The Next.js frontend reads its own variable; set it in your shell or tennis/frontend/.env.local
# (not here: the backend settings reject unknown keys):
#   NEXT_PUBLIC_API_URL=http://localhost:8000
